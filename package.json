{
  "name": "tinyclaw",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp bridge for local LLM CLIs (claude, codex, copilot) and shell access",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tinyclaw": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "selftest": "node dist/selftest.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "baileys": "6.7.23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
